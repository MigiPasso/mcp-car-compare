.git
.gitignore
.github/
.venv
__pycache__/
*.pyc
*.pyo
.pytest_cache/
# Les tests ne servent pas à l'exécution : la preuve E0 se lance depuis un
# conteneur jetable qui monte le dépôt, pas depuis l'image de production.
tests/
# requirements-dev.txt n'apporte que pytest ; l'image ne teste rien.
requirements-dev.txt
# Une base locale ne doit jamais entrer dans l'image : le corpus est un volume.
*.db
*.db-journal
data/
# Rien de ce qui documente le dépôt n'a besoin d'être dans l'image.
*.md
mcp.example.json
# Aucune variable d'environnement, aucun secret, ne s'embarque dans une image.
.env
.env.*
